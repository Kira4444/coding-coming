# ============================================================
# Coding Agent 环境变量模板
# 复制成 .env 后按需修改。.env 已在 .gitignore 中，切勿入库。
# ============================================================

# ---------- 模型接入 ----------
# 必须至少配一个，否则 agent 无法工作。

# 小米 MiMo（默认 provider）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# 智谱 GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 默认用哪家（对应上方配置段的 key）
CODING_AGENT_DEFAULT_PROVIDER=mimo

# ---------- 凭据加密 ----------
# 推送凭据（deploy token / SSH key）入库前用它加密。
# 缺失时服务拒绝启动——绝不明文存凭据。
# 生成：openssl rand -base64 32
CODING_AGENT_SECRET_KEY=

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=coding_agent
MYSQL_USER=coding_agent
MYSQL_PASSWORD=coding_agent
# root 密码仅用于容器初始化，不要拿它跑应用
MYSQL_ROOT_PASSWORD=change-me

# ---------- 沙箱 ----------
# local  = 命令直接跑在宿主机上，无隔离，仅限开发环境
# docker = 一会话一容器，服务器部署必须用这个
CODING_AGENT_SANDBOX_DRIVER=local

# 官方默认镜像（需先 build，见 README）
CODING_AGENT_SANDBOX_IMAGE=coding-agent/sandbox:latest

# 网络策略：public = 允许公网出网；none = 断网
CODING_AGENT_SANDBOX_NETWORK=public

# 资源限额
CODING_AGENT_SANDBOX_CPU=2
CODING_AGENT_SANDBOX_MEMORY=4g

# 同时执行的 agent 会话数上限，超出排队
CODING_AGENT_MAX_CONCURRENT=4

# ---------- 工作区 ----------
CODING_AGENT_WORKSPACE_ROOT=./data/workspaces

# ---------- agent 预算 ----------
CODING_AGENT_MAX_TURNS=40
CODING_AGENT_TOKEN_BUDGET=500000

# ---------- 日志 ----------
CODING_AGENT_LOG_LEVEL=INFO
